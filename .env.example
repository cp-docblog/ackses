# Copy to .env.local and fill in from your Supabase project
# (Project Settings → API). Until both are set the app reads the bundled demo
# fixtures in src/data/fixtures.ts, which mirror supabase/seed.sql.
#
# EXPO_PUBLIC_ variables are inlined into the JS bundle, so only ever put the
# publishable anon key here — never the service role key.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
